# 회사별 설정 양식. main 브랜치에는 이 양식만 둔다.
#
# 사용법: 회사 브랜치에서 config/company.env 로 복사해 값을 채운다.
#   cp config/company.example.env config/company.env
# KEY=VALUE 한 줄에 하나. 따옴표 없이 쓴다. 비밀값(토큰)은 여기 두지 않고 .env 에 둔다.
# bash(scripts/lib/config.sh)와 PowerShell(scripts/collect/windows/collect.ps1)이 같은 파일을 읽는다.

# 1. 누구의 기록인가
COMPANY=example
MY_NAME=홍길동
TEAM_NAME=

# 2. 자동 실행 시각 (평일). 수집을 마친 뒤 이어서 브리핑·일지를 쓴다.
MORNING_AT=08:40
EVENING_AT=17:20
# 주간보고를 쓰는 요일(1=월 ... 5=금)과 주간 회의 요일. 브리핑이 그날 알려 준다.
WEEKLY_REPORT_DOW=3
WEEKLY_MEETING_DOW=4

# 3. 실행기 (브리핑·일지를 쓰는 PC). 기본은 Windows 가 수집과 작성을 모두 한다(scripts/run/windows/).
# 레포가 다른 PC 의 공유 폴더에 있을 때, 그 공유를 연결할 드라이브 문자(예: W:). 공유에 두었으면 꼭 채운다.
# \\서버\공유 경로를 작업 폴더로 Claude 를 띄우면 권한 규칙이 맞지 않아 파일 읽기가 거부된다(2026-11-16 확인).
REPO_DRIVE=
# 주로 일하는 Linux PC (선택). 설정하면 그 PC 의 Claude Code 채팅·커밋을 SSH 로 뽑아 일지 재료로 쓴다.
# 비밀번호 없는 SSH 키 접속이 전제다. LINUX_REPO 는 그 PC 에서 본 이 레포의 경로다.
LINUX_HOST=
LINUX_REPO=
# 1 이면 브리핑·일지가 준비됐을 때 Linux 바탕화면에도 알림을 띄운다.
LINUX_NOTIFY=0

# Claude 실행 (실행기가 도는 PC 기준)
# 비우면 ~/.local/bin/claude 를 쓴다.
CLAUDE_BIN=
# 브리핑·일지에 쓸 모델(예: sonnet). 비우면 Claude Code 기본 모델을 쓰는데, 기본값을 못 알아보는 경고가 날 수 있다.
CLAUDE_MODEL=
RUN_TIMEOUT_MIN=20

# 4. 수집. 쓰지 않는 항목은 0 으로 끈다.
COLLECT_OUTLOOK=1
COLLECT_TEAMS=1
TEAMS_TOP=20
# 녹음 프로그램이 records/inbox/ 아래에 바로 저장하면 비워 둔다(복사 작업도 등록되지 않는다).
# 다른 폴더에 저장한다면 그 폴더(Windows 경로)를 적는다. 새 *.transcript.txt 를 records/inbox/transcripts/ 로 복사한다.
# 비우면 복사하지 않는다(전사를 inbox 에 직접 넣는 경우).
RECORDING_DIR=
# 1 이면 전사와 이름이 같은 녹음 파일(webm·m4a·mp3·wav)도 같이 복사한다. 녹음은 git 에 올라가지 않는다.
COPY_RECORDINGS=1
# 새 전사를 확인하는 간격(분). 근무 시간(09:00 부터 10시간) 동안 돈다.
TRANSCRIPT_EVERY_MIN=10

# 5. 이슈 트래커 (선택). 비우면 트래커 조회·대기열 반영 단계를 건너뛴다.
# 조회 명령은 뒤에 항목 번호가 붙어 실행된다. 예: python3 scripts/tracker/get.py
TRACKER_NAME=
TRACKER_GET_CMD=

# 6. 주간보고를 올릴 곳 (선택). 비우면 records/weekly/ 에만 둔다.
WEEKLY_UPLOAD_DIR=
